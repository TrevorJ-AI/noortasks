{
  "name": "@noortasks/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NoorTasks desktop hub",
  "license": "MIT",
  "author": {
    "name": "NoorTasks contributors"
  },
  "main": "dist/main.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "pnpm --filter @noortasks/web build && node scripts/build.mjs",
    "start": "electron .",
    "package:linux": "pnpm build && electron-builder --linux AppImage --x64 --publish never",
    "package:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^10.1.11",
    "fastify": "^5.0.0",
    "node-ical": "^0.27.6",
    "openid-client": "^6.9.0",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "uqr": "^0.1.3",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "app.noortasks.desktop",
    "productName": "NoorTasks",
    "directories": {
      "output": "dist/installers",
      "buildResources": "build"
    },
    "files": [
      "dist/main.js",
      "dist/preload.cjs",
      "dist/phone/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      }
    ],
    "asar": true,
    "npmRebuild": false,
    "publish": null,
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "NoorTasks-${version}-${arch}.${ext}",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "NoorTasks-${version}-Setup-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "executableName": "noortasks"
  },
  "desktopName": "noortasks.desktop"
}
